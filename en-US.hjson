				FlailChanges: {
					Label: Flail Changes
					Tooltip: Tweaks for all flails
				}

				Misc: {
					Label: Misc changes
					Tooltip: Random changes I didn't bundle together.
				}

				MeleeArmorChanges: {
					Label: Melee Armor Changes
					Tooltip: Melee armor gives less defense but more offense
				}

				SimpleArrowCompatibility: {
					Label: Simple Arrow Compatibility
					Tooltip: Arrows that only apply a debuff will synergize with special bow projectiles like wooden arrows
				}

				OverloadMechanic: {
					Label: Overload Mechanic
					Tooltip: Overload your ranged weapon for extra damage at the cost of extra ammo
				}

				BlessedMechanic: {
					Label: Blessed Mechanic
					Tooltip: Bless a magic weapon to reduce damage but greatly improve mana management
				}

				PostMechMimics: {
					Label: Post Mech Mimics
					Tooltip: Biome mimics are post-mech but their weapons are a lot better
				}

				SwordParries: {
					Label: Sword Parries
					Tooltip: All swords can parry like Brand of the Inferno
				}

				OldManQuest: {
					Tooltip: The Old Man can give you a dungeon weapon before defeating Skeletron
					Label: Old Man Quest
				}

				LifestealRework: {
					Label: Lifesteal Rework
					Tooltip: Changes lifesteal mechanic to be more balanced and reward proactive use
				}

				BiomeKeyWeapons: {
					Tooltip: Biome Key weapon buffs/reworks, making them much more impactful
					Label: Biome Key Weapons
				}

				OldOneArmyBuffs: {
					Label: Old One's Army Buffs
					Tooltip: Improvements to some OOA weapons, made events harder but less grindy
				}
