				Headers.General: General Header
				DisplayName: Shiny Config

				TerraBladeTree: {
					Label: Terra Blade Tree
					Tooltip: Changes and tweaks to all swords from the Terra Blade tree
				}

				SwordProjectileRates: {
					Label: Sword Projectile Rates
					Tooltip: Projectile fire rates from swords will scale with melee speed
				}

				SwordProjectileReworks: {
					Label: Sword Projectile Reworks
					Tooltip: Changes a bunch of projectiles shot by swords, making them more unique.
